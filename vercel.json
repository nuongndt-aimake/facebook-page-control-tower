{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/api/admin/payment-profiles", "destination": "/api/admin/access" },
    { "source": "/api/admin/preview", "destination": "/api/admin/access?endpoint=preview" },
    { "source": "/api/posts/publication", "destination": "/api/analytics?action=publication" },
    { "source": "/api/posts/sync-request", "destination": "/api/analytics?action=sync-request" },
    { "source": "/api/cron/post-sync", "destination": "/api/cron/sync?worker=post" }
  ],
  "crons": [
    { "path": "/api/cron/sync", "schedule": "0 1 * * *" }
  ]
}
