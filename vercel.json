{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/sales", "destination": "/sales.html" },
    { "source": "/inventory/fanpages", "destination": "/inventory-fanpages.html" },
    { "source": "/api/admin/payment-profiles", "destination": "/api/admin/access?endpoint=payout" },
    { "source": "/api/admin/preview", "destination": "/api/admin/access?endpoint=preview" },
    { "source": "/api/admin/sales-orders", "destination": "/api/admin/access?endpoint=sales-orders" },
    { "source": "/api/payments/sepay", "destination": "/api/admin/access?endpoint=sepay-webhook" },
    { "source": "/api/checkout", "destination": "/api/admin/access?endpoint=public-checkout" },
    { "source": "/api/sales-config", "destination": "/api/admin/access?endpoint=public-sales-config" },
    { "source": "/api/checkout/qr", "destination": "/api/admin/access?endpoint=public-qr-download" },
    { "source": "/api/posts/publication", "destination": "/api/analytics?action=publication" },
    { "source": "/api/posts/sync-request", "destination": "/api/analytics?action=sync-request" },
    { "source": "/api/cron/post-sync", "destination": "/api/cron/sync?worker=post" }
  ],
  "crons": [
    { "path": "/api/cron/sync?slot=slot_06", "schedule": "0 23 * * *" },
    { "path": "/api/cron/sync?slot=slot_14", "schedule": "0 7 * * *" },
    { "path": "/api/cron/sync?slot=slot_22", "schedule": "0 15 * * *" },
    { "path": "/api/cron/post-sync", "schedule": "30 16 * * *" }
  ]
}
